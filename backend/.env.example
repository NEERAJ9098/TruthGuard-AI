# TruthGuard AI Environment Variables
# HackNova Bhopal 2K26

# Google Gemini API Key (Required for live Gemini AI verification)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Fact Check Tools API Key (Optional)
# Get key at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=

# NewsAPI Key (Optional, for additional live news searching)
# Get key at: https://newsapi.org/
NEWS_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# SQLite Database Location
DATABASE_URL=sqlite:///./truthguard.db
